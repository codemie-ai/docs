#!/usr/bin/env bash
# apply-theme — validate, render and (optionally) apply a theme package to a cluster
# Prerequisites: yq >=4, ajv-cli >=6, helm >=3, kubectl >=1.25
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCHEMA="$SCRIPT_DIR/theme-package.schema.json"

RENDER_ONLY=false
NAMESPACE="default"
RELEASE_UI="codemie-ui"
RELEASE_CODEMIE="codemie"
OUTPUT_DIR=""

usage() {
  echo "Usage: apply-theme [--render-only] [--namespace <ns>]"
  echo "         [--release-ui <name>] [--release-codemie <name>]"
  echo "         [--output-dir <dir>]"
  echo "         <theme-package.yaml> <assets-dir>"
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --render-only) RENDER_ONLY=true; shift ;;
    --namespace) NAMESPACE="$2"; shift 2 ;;
    --release-ui) RELEASE_UI="$2"; shift 2 ;;
    --release-codemie) RELEASE_CODEMIE="$2"; shift 2 ;;
    --output-dir) OUTPUT_DIR="$2"; shift 2 ;;
    --help | -h) usage ;;
    -*) echo "Unknown option: $1"; usage ;;
    *) break ;;
  esac
done

[[ $# -lt 2 ]] && usage
PACKAGE_FILE="$1"
ASSETS_DIR="$2"

# ── Phase 1: validate ────────────────────────────────────────────────────────
ERRORS=()

# 1a. JSON Schema validation
_AJV_TMP=$(mktemp /tmp/ajv-input-XXXXXX.json)
yq eval -o=json "$PACKAGE_FILE" >"$_AJV_TMP"
if ! ajv validate -s "$SCHEMA" --spec draft7 -d "$_AJV_TMP" >/tmp/ajv-err 2>&1; then
  while IFS= read -r line; do ERRORS+=("$line"); done </tmp/ajv-err
fi
rm -f "$_AJV_TMP"

# 1b. Asset existence check (only if schema passed)
if [[ ${#ERRORS[@]} -eq 0 ]]; then
  for key in logoLight logoDark favicon faviconSvg manifest; do
    fname=$(yq eval ".assets.$key" "$PACKAGE_FILE")
    [[ -f "$ASSETS_DIR/$fname" ]] || ERRORS+=("assets.$key: file not found: $ASSETS_DIR/$fname")
  done
fi

# 1c. Enabled-link cross-check against customer-config.yaml
# Locate customer-config.yaml via env var or conventional path
CUSTOMER_CONFIG="${CUSTOMER_CONFIG_PATH:-/etc/codemie/customer-config.yaml}"
if [[ -f "$CUSTOMER_CONFIG" ]]; then
  LINK_IDS=(
    userGuide videoPortal youtubeChannel learningCourses customerSupport
    userSurvey workflowDocumentation workflowYamlDocumentation googleDocsDocumentation
  )
  for lid in "${LINK_IDS[@]}"; do
    enabled=$(yq eval ".components[] | select(.id == \"$lid\") | .settings.enabled" \
      "$CUSTOMER_CONFIG" 2>/dev/null || echo "false")
    if [[ "$enabled" == "true" ]]; then
      present=$(yq eval ".links.$lid" "$PACKAGE_FILE" 2>/dev/null || echo "null")
      [[ "$present" == "null" ]] && ERRORS+=("links.$lid: enabled in customer-config but absent from package")
    fi
  done
fi

if [[ ${#ERRORS[@]} -gt 0 ]]; then
  echo "apply-theme: validation failed:" >&2
  for e in "${ERRORS[@]}"; do echo "  - $e" >&2; done
  exit 1
fi

# ── Phase 2: render ──────────────────────────────────────────────────────────
WORK_DIR="${OUTPUT_DIR:-$(mktemp -d /tmp/apply-theme-XXXXXX)}"
mkdir -p "$WORK_DIR"

PKG_JSON=$(yq eval -o=json "$PACKAGE_FILE")
CHECKSUM=$(sha256sum "$PACKAGE_FILE" | awk '{print $1}')

# Render brand.css
{
  FONT_FACE=$(echo "$PKG_JSON" | yq eval '.typography.fontFaceCSS // ""' -)
  [[ -n "$FONT_FACE" ]] && echo "$FONT_FACE"
  echo ":root {"
  echo "$PKG_JSON" | yq eval '.typography | to_entries | .[] | "  --font-family-" + .key + ": " + .value + ";"' - |
    grep -v fontFaceCSS
  echo "$PKG_JSON" | yq eval '.colors | to_entries | .[] |
    "  --colors-" + (.key | sub("\\."; "-")) + "-dark: " + .value.dark + ";\n" +
    "  --colors-" + (.key | sub("\\."; "-")) + "-light: " + .value.light + ";"' -
  echo "}"
} >"$WORK_DIR/brand.css"

# Base64-encode assets (individual variables for bash 3 compatibility)
# base64 flags differ: GNU uses -w0 to disable line wrapping; macOS uses -i for input file
_b64() { base64 -w0 "$1" 2>/dev/null || base64 -i "$1" 2>/dev/null || base64 <"$1"; }
ASSET_LOGOLIGHT_FILE=$(echo "$PKG_JSON" | yq eval '.assets.logoLight' -)
ASSET_LOGODARK_FILE=$(echo "$PKG_JSON" | yq eval '.assets.logoDark' -)
ASSET_FAVICON_FILE=$(echo "$PKG_JSON" | yq eval '.assets.favicon' -)
ASSET_FAVICONSVG_FILE=$(echo "$PKG_JSON" | yq eval '.assets.faviconSvg' -)
ASSET_MANIFEST_FILE=$(echo "$PKG_JSON" | yq eval '.assets.manifest' -)
B64_LOGOLIGHT=$(_b64 "$ASSETS_DIR/$ASSET_LOGOLIGHT_FILE")
B64_LOGODARK=$(_b64 "$ASSETS_DIR/$ASSET_LOGODARK_FILE")
B64_FAVICON=$(_b64 "$ASSETS_DIR/$ASSET_FAVICON_FILE")
B64_FAVICONSVG=$(_b64 "$ASSETS_DIR/$ASSET_FAVICONSVG_FILE")
B64_MANIFEST=$(_b64 "$ASSETS_DIR/$ASSET_MANIFEST_FILE")

PRODUCT_NAME=$(echo "$PKG_JSON" | yq eval '.product.name' -)
PRODUCT_SHORT=$(echo "$PKG_JSON" | yq eval '.product.shortName' -)

# Render values-codemie-ui.brand.yaml
cat >"$WORK_DIR/values-codemie-ui.brand.yaml" <<YAML
brand:
  enabled: true
  product:
    name: "${PRODUCT_NAME}"
    shortName: "${PRODUCT_SHORT}"
  assets:
    logoLight: "${ASSET_LOGOLIGHT_FILE}"
    logoDark: "${ASSET_LOGODARK_FILE}"
    favicon: "${ASSET_FAVICON_FILE}"
    faviconSvg: "${ASSET_FAVICONSVG_FILE}"
    manifest: "${ASSET_MANIFEST_FILE}"
  brandCssContent: |
$(awk '{print "    " $0}' "$WORK_DIR/brand.css")
  logoLightData: "${B64_LOGOLIGHT}"
  logoDarkData: "${B64_LOGODARK}"
  faviconData: "${B64_FAVICON}"
  faviconSvgData: "${B64_FAVICONSVG}"
  manifestData: "${B64_MANIFEST}"
  podAnnotations:
    checksum/brand: "${CHECKSUM}"
YAML

# Render values-codemie.brand.yaml (links overlay)
{
  echo "podAnnotations:"
  echo "  checksum/brand: \"${CHECKSUM}\""
  echo "extraObjects:"
  echo "  - apiVersion: v1"
  echo "    kind: ConfigMap"
  echo "    metadata:"
  echo "      name: codemie-brand"
  echo "    data:"
  echo "      brand.yaml: |"
  echo "        links:"
  echo "$PKG_JSON" | yq eval '.links | to_entries | .[] |
    "          " + .key + ":\n            name: " + .value.name + "\n            url: " + .value.url' -
} >"$WORK_DIR/values-codemie.brand.yaml"

echo "apply-theme: rendered files written to $WORK_DIR"

[[ "$RENDER_ONLY" == "true" ]] && exit 0

# ── Phase 3: upgrade ─────────────────────────────────────────────────────────
helm upgrade "$RELEASE_UI" "$(helm get metadata "$RELEASE_UI" -n "$NAMESPACE" -o yaml | yq eval '.chart' -)" \
  --reuse-values \
  -f "$WORK_DIR/values-codemie-ui.brand.yaml" \
  -n "$NAMESPACE"

helm upgrade "$RELEASE_CODEMIE" "$(helm get metadata "$RELEASE_CODEMIE" -n "$NAMESPACE" -o yaml | yq eval '.chart' -)" \
  --reuse-values \
  -f "$WORK_DIR/values-codemie.brand.yaml" \
  -n "$NAMESPACE"

# ── Phase 4: restart ─────────────────────────────────────────────────────────
kubectl rollout restart "deployment/$RELEASE_UI" -n "$NAMESPACE"
kubectl rollout restart "deployment/$RELEASE_CODEMIE" -n "$NAMESPACE"
kubectl rollout status "deployment/$RELEASE_UI" -n "$NAMESPACE" --timeout=120s
kubectl rollout status "deployment/$RELEASE_CODEMIE" -n "$NAMESPACE" --timeout=120s

echo "apply-theme: done"
