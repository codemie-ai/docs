#!/usr/bin/env bash
# Recording stub: logs every call; answers `get metadata` and `get values` like Helm 3.9+.
echo "helm $*" >> "$BATS_TMPDIR/helm-calls"
if [[ "$1" == "get" && "$2" == "metadata" ]]; then
  printf 'name: %s\nchart: fake-chart\nversion: 1.2.3\nappVersion: 9.9.9\n' "$3"
elif [[ "$1" == "get" && "$2" == "values" ]]; then
  if [[ -n "${HELM_STUB_VALUES:-}" ]]; then cat "$HELM_STUB_VALUES"; else echo "{}"; fi
fi
exit 0
