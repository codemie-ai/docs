{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codemie-ai.github.io/docs/kit/theme-package.schema.json",
  "title": "ThemePackage",
  "type": "object",
  "required": ["version", "product", "colors", "typography", "assets", "links"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "product": {
      "type": "object",
      "required": ["name", "shortName"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^<>\"\\\\\\u0000-\\u001f]+$"
        },
        "shortName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[^<>\"\\\\\\u0000-\\u001f]+$"
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["dark", "light"],
        "additionalProperties": false,
        "properties": {
          "dark": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "light": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*$"
      }
    },
    "typography": {
      "type": "object",
      "required": ["bodyFamily", "bodyProseFamily", "codeFamily"],
      "additionalProperties": false,
      "properties": {
        "bodyFamily": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^;{}<>()!\\\\\\u0000-\\u001f]+$"
        },
        "bodyProseFamily": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^;{}<>()!\\\\\\u0000-\\u001f]+$"
        },
        "codeFamily": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^;{}<>()!\\\\\\u0000-\\u001f]+$"
        },
        "fontFaceCSS": {
          "type": ["string", "null"],
          "pattern": "^(?![\\s\\S]*!important)[\\s\\S]*$"
        }
      }
    },
    "assets": {
      "type": "object",
      "required": ["logoLight", "logoDark", "favicon", "faviconSvg", "manifest"],
      "additionalProperties": false,
      "properties": {
        "logoLight": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
          "maxLength": 100
        },
        "logoDark": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
          "maxLength": 100
        },
        "favicon": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
          "maxLength": 100
        },
        "faviconSvg": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
          "maxLength": 100
        },
        "manifest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
          "maxLength": 100
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userGuide": {
          "$ref": "#/definitions/link"
        },
        "videoPortal": {
          "$ref": "#/definitions/link"
        },
        "youtubeChannel": {
          "$ref": "#/definitions/link"
        },
        "learningCourses": {
          "$ref": "#/definitions/link"
        },
        "customerSupport": {
          "$ref": "#/definitions/link"
        },
        "userSurvey": {
          "$ref": "#/definitions/link"
        },
        "workflowDocumentation": {
          "$ref": "#/definitions/link"
        },
        "workflowYamlDocumentation": {
          "$ref": "#/definitions/link"
        },
        "googleDocsDocumentation": {
          "$ref": "#/definitions/link"
        }
      }
    }
  },
  "definitions": {
    "link": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^(?!.*\\{\\{)(?!.*\\}\\})[^\\u0000-\\u001f]+$"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^https?://[^\\s\\u0000-\\u001f{}]+$"
        }
      }
    }
  }
}
